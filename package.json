{
  "name": "simple-calendars",
  "version": "2.0.0",
  "description": "Multi-entity Monthly, Daily, and Focus Event Lovelace calendar cards for Home Assistant",
  "type": "module",
  "main": "dist/simple-calendars.js",
  "scripts": {
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('dist/simple-calendars.js','simple-calendars.js')\"",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node tests/verify.mjs"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "marketplace",
    "calendar",
    "custom-card"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
